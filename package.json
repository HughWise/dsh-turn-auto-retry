{
  "name": "dsh-turn-auto-retry",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: retry a failed model request, tell the model why it failed and how the called tool must be called, and stop only after the same failure repeats past a configurable limit.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "retry",
    "tool-call",
    "malformed-json"
  ],
  "license": "MIT",
  "author": "xuhuazhi1",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/unit.mjs",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File test/e2e.ps1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
